{
  "name": "@flux/api",
  "version": "0.1.0",
  "private": true,
  "description": "Flux 云端 SaaS API（NestJS）",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "demo:exec": "nest build && node dist/modules/executions/engine.demo.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@flux/node-sdk": "workspace:*",
    "@flux/shared": "workspace:*",
    "@flux/workflow-schema": "workspace:*",
    "@nestjs/common": "^10.4.1",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.4.1",
    "@nestjs/platform-express": "^10.4.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.4",
    "@nestjs/schematics": "^10.1.4",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.15",
    "rimraf": "^6.0.1",
    "typescript": "^5.5.4"
  }
}
