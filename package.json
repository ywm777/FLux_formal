{
  "name": "flux-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Flux 无界工作流 — Windows 桌面端 + SaaS 云端 monorepo",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "pnpm -r run lint",
    "clean": "pnpm -r run clean",
    "dev:desktop": "pnpm --filter @flux/desktop run dev",
    "dev:api": "pnpm --filter @flux/api run dev"
  },
  "devDependencies": {
    "typescript": "^5.5.4"
  }
}
