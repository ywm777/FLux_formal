{
  "name": "@flux/workflow-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "pnpm --filter @flux/node-sdk build && pnpm build && node --test test/*.test.mjs",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@flux/node-sdk": "workspace:*",
    "@flux/shared": "workspace:*",
    "@flux/workflow-schema": "workspace:*"
  },
  "devDependencies": {
    "rimraf": "^6.0.1",
    "typescript": "^5.5.4"
  }
}
