{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": false,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
      "@flux/shared": ["packages/shared/src/index.ts"],
      "@flux/workflow-schema": ["packages/workflow-schema/src/index.ts"],
      "@flux/node-sdk": ["packages/node-sdk/src/index.ts"],
      "@flux/canvas-core": ["packages/canvas-core/src/index.ts"],
      "@flux/ui": ["packages/ui/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "dist", "build", "out"]
}
