# ===== API (apps/api) =====
NODE_ENV=development
API_PORT=3000
API_HOST=127.0.0.1
# 浏览器来源白名单，逗号分隔；生产环境不配置时默认拒绝跨域浏览器请求
CORS_ORIGINS=http://localhost:5173

# Database (PostgreSQL)
DATABASE_URL=postgresql://flux:flux@localhost:5432/flux

# Redis (BullMQ)
REDIS_URL=redis://localhost:6379
# Worker 持久化租约与跨进程控制轮询
EXEC_WORKER_LEASE_MS=30000
EXEC_CONTROL_POLL_MS=250
# 队列并发、容量与 BullMQ 尝试次数
EXEC_CONCURRENCY=4
EXEC_QUEUE_CAPACITY=200
EXEC_ATTEMPTS=1

# API 单实例安全下限；多实例生产环境还应在网关/Redis 配置租户级限流
AUTH_RATE_LIMIT_PER_MINUTE=20
EXPENSIVE_RATE_LIMIT_PER_MINUTE=60
API_RATE_LIMIT_PER_MINUTE=300

# Auth
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# 仅限显式本地联调；生产环境强制禁用，未启用时微信/短信端点返回 503
AUTH_MOCK_CHANNELS=false
SMS_DEV_CODE=000000

# WeChat / SMS (多渠道登录，二期接入)
WECHAT_APP_ID=
WECHAT_APP_SECRET=
SMS_PROVIDER_KEY=

# AI Proxy（优先开源模型）
AI_PROXY_BASE_URL=
AI_PROXY_API_KEY=
AI_PROXY_PROVIDER=openai-compatible
AI_DEFAULT_MODEL=llama3
AI_REQUEST_TIMEOUT_MS=30000
AI_MAX_RESPONSE_BYTES=2097152
# 生产环境默认禁止连接内网；仅自托管且明确需要时设为 true
AI_ALLOW_PRIVATE_NETWORKS=false
# 生产环境必填；用于 AES-256-GCM 加密用户的 AI API Key
AI_CREDENTIAL_ENCRYPTION_KEY=
# 未配置 AI_PROXY_BASE_URL 时的本地 Ollama 兼容兜底
OLLAMA_URL=http://localhost:11434

# ===== Desktop (apps/desktop) =====
VITE_API_BASE_URL=http://localhost:3000
# 对外分享链接使用的 Web 应用地址；桌面生产环境必须配置为可访问域名
VITE_PUBLIC_APP_URL=http://localhost:5173
